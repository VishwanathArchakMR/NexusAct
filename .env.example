# ==============================================================================
# NexusAct (GAF - GraphAction Fabric) Environment Configuration
# ==============================================================================

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=NexusAct
APP_VERSION=0.1.0

# Backend API Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated, explicit - no wildcard '*')
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FalkorDB Graph Database Configuration
# Local host is 127.0.0.1 when running outside containers, or falkordb when inside Docker network
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_PRIMARY_GRAPH=nexusact_main
FALKORDB_CONNECTION_TIMEOUT_MS=5000

# MCP (Model Context Protocol) Diagnostic Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_LOG_LEVEL=INFO

# Frontend Configuration (Used by Vite dev server / build)
VITE_API_BASE_URL=http://localhost:8000

# Future AI Model Provider Configuration (Disabled / Unused in Phase 1)
# Note: Basic startup, health checks, and database operations do NOT require an LLM or API keys.
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OPENAI_API_KEY=

# Future GitHub Action Integration Configuration (Unused in Phase 1)
# Note: No GitHub API calls are executed in Phase 1.
GITHUB_TOKEN=
GITHUB_REPO=
