# ==============================================================================
# NexusAct (GAF - GraphAction Fabric) Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit a .env file with real secrets to Git.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
# Set to "production" when deploying; disables Swagger UI and enables TrustedHostMiddleware.
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=NexusAct
APP_VERSION=0.2.0

# When true, disables unauthenticated file uploads, arbitrary repo cloning, and external actions.
# Set to true for public deployments to protect against abuse.
PUBLIC_DEMO_MODE=false

# Production Caddy domain for automatic HTTPS (e.g. nexusact.duckdns.org or :80)
DOMAIN=

# ── Backend API Server ─────────────────────────────────────────────────────────
# For local dev: 127.0.0.1. For Docker: 0.0.0.0 (container exposes through port mapping).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use '*'.
# In production, set this to your actual frontend domain(s).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── FalkorDB Graph Database ─────────────────────────────────────────────────────
# Local host is 127.0.0.1 when running outside containers.
# When using docker-compose.prod.yml, set FALKORDB_HOST=falkordb (service name).
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_PRIMARY_GRAPH=nexusact_main
FALKORDB_CONNECTION_TIMEOUT_MS=5000

# ── MCP (Model Context Protocol) Server ─────────────────────────────────────────
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_LOG_LEVEL=INFO

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# URL of the backend API reachable from the user's browser (not internal Docker network).
# In production, set this to your public backend URL before running "npm run build".
VITE_API_BASE_URL=http://localhost:8000

# ── AI Model Provider ──────────────────────────────────────────────────────────
# NexusAct runs entirely without an LLM using heuristic graph-grounded investigation.
# Set LLM_PROVIDER=gemini (recommended) or LLM_PROVIDER=ollama for model-assisted tool planning.
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Google Gemini API configuration (when LLM_PROVIDER=gemini)
# Both GEMINI_API_KEY and GOOGLE_API_KEY are supported aliases.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: OpenAI API key (only if LLM_PROVIDER=openai is desired)
OPENAI_API_KEY=

# ── GitHub Integration ─────────────────────────────────────────────────────────
# Required for public GitHub repository onboarding (higher rate limits) and
# for the GitHub Action issue-proposal submission feature.
# Minimum required scopes: repo, public_repo
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=
