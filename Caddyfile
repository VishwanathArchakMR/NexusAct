{
    # NexusAct Caddy Ingress Configuration
    # Automatically manages HTTPS certificates when DOMAIN is configured
    admin off
}

# Domain placeholder (e.g. nexusact.duckdns.org or IP:80)
# Defaults to HTTP port 80 if DOMAIN is unset
{$DOMAIN::80} {
    encode gzip zstd

    # Gateway liveness check (Railway ingress health probe).
    handle /gateway-health {
        respond "OK" 200
    }

    # Backend API and health routes
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
    }

    handle /health {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
    }

    handle /ready {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
    }

    handle /docs {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
    }

    handle /openapi.json {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
    }

    # Frontend SPA and static assets
    handle {
        reverse_proxy {$FRONTEND_UPSTREAM:frontend:80}
    }
}
